def code = (obj instanceof Map) ? obj.get(&apos;code&apos;) : null
def message = (obj instanceof Map) ? (obj.get(&apos;message&apos;) ?: obj.get(&apos;msg&apos;) ?: &apos;&apos;) : &apos;&apos;
