          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取非敏感结果字段" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.nio.file.Files
import java.nio.file.Paths
import java.nio.file.StandardOpenOption

def label = prev.getSampleLabel()
def text = prev.getResponseDataAsString()
def obj = null
try { obj = new JsonSlurper().parseText(text) } catch (Throwable ignored) {}
def data = (obj instanceof Map) ? obj.get(&apos;data&apos;) : null
def token = (data instanceof Map) ? data.get(&apos;token&apos;) : null
def uid = (data instanceof Map) ? data.get(&apos;uid&apos;) : null
def pid = (data instanceof Map) ? data.get(&apos;pid&apos;) : null
def code = (obj instanceof Map) ? obj.get(&apos;code&apos;) : null
def message = (obj instanceof Map) ? (obj.get(&apos;message&apos;) ?: obj.get(&apos;msg&apos;) ?: &apos;&apos;) : &apos;&apos;
def fields = (data instanceof Map) ? data.keySet().collect{it.toString()}.sort().join(&apos;|&apos;) : &apos;&apos;
def isB64 = { v -&gt;
  if (v == null) return true
  if (!(v instanceof String)) return false
  def q=v.toString(); def ix=q.indexOf(&apos;base64,&apos;); if (ix &gt;= 0) q=q.substring(ix+7)
  try { java.util.Base64.decoder.decode(q); return true } catch (Throwable ignored) { return false }
}
def identityImageValid = (data instanceof Map) ? isB64(data.get(&apos;identityImage&apos;)) : false
def imageDataValid = (data instanceof Map) ? isB64(data.get(&apos;imageData&apos;)) : false
def passwordPresent = (obj instanceof Map &amp;&amp; obj.containsKey(&apos;password&apos;)) || (data instanceof Map &amp;&amp; data.containsKey(&apos;password&apos;))
def tokenPresent = token != null &amp;&amp; token.toString().length() &gt; 20
if (label.startsWith(&apos;P0_M1-020&apos;)) {
  vars.put(&apos;studentToken&apos;, tokenPresent ? token.toString() : &apos;&apos;)
  vars.put(&apos;studentUid&apos;, uid == null ? &apos;&apos; : uid.toString())
  if (tokenPresent) {
    def t = token.toString()
    def last = t.substring(t.length()-1)
    vars.put(&apos;studentTokenTampered&apos;, t.substring(0,t.length()-1) + (last == &apos;A&apos; ? &apos;B&apos; : &apos;A&apos;))
  } else { vars.put(&apos;studentTokenTampered&apos;,&apos;invalid-token&apos;) }
}
if (label.startsWith(&apos;P0_M1-021&apos;)) { vars.put(&apos;merchantToken&apos;, tokenPresent ? token.toString() : &apos;&apos;) }
def safe = [label, prev.getResponseCode(), prev.isSuccessful(), code == null ? &apos;&apos; : code.toString(), message.toString().replaceAll(&apos;[\r\n,]+&apos;,&apos; &apos;).replace(&apos;&quot;&apos;,&apos;&apos;), tokenPresent, pid == null ? &apos;&apos; : pid.toString(), fields, passwordPresent, identityImageValid, imageDataValid, prev.getTime()]
def line = safe.collect{ &apos;&quot;&apos; + it.toString().replace(&apos;&quot;&apos;,&apos;&quot;&quot;&apos;) + &apos;&quot;&apos; }.join(&apos;,&apos;) + System.lineSeparator()
synchronized(props) { Files.write(Paths.get(&apos;D:/User/Documents/ChatGPT/校园兼职系统接口测试-Jmeter/M1-020-037_脱敏明细.csv&apos;), line.getBytes(&apos;UTF-8&apos;), StandardOpenOption.CREATE, StandardOpenOption.APPEND) }
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言M1-003商家接口访问成功" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def code = body?.code?.toString()
def message = body?.message?.toString()

def hasStore = code == &apos;200&apos;
def noStore = code == &apos;500&apos; &amp;&amp; message?.contains(&apos;该商家没有店铺信息&apos;)

if (!hasStore &amp;&amp; !noStore) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(
        &quot;店铺列表响应不符合预期：code=${code}, message=${message}&quot;
    )
}</stringProp>
          </JSR223Assertion>
